# ШКВОРЕНЬ — переменные окружения (docs/technical-spec.md §4)
# Скопировать в .env.local и заполнить. Реальные значения в git не попадают.

# --- Google Sheets: единственный мастер-источник данных (решение 1) ---------
# Сервисный аккаунт с правом записи в таблицу. Ключ читается ТОЛЬКО lib/sheets.ts.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Приватный ключ одной строкой, переводы строк экранированы как \n
GOOGLE_PRIVATE_KEY=
# ID Google-таблицы — из её адреса: docs.google.com/spreadsheets/d/<SHEET_ID>/edit
SHEET_ID=
# Имена листов. Менять только если листы в таблице названы иначе.
SHEET_PARTS_NAME=Запчасти
SHEET_ORDERS_NAME=Заказы

# --- Админка: один пароль, один оператор (решение 6) -----------------------
ADMIN_PASSWORD=
# Секрет для подписи cookie сессии. Сгенерировать: openssl rand -hex 32
ADMIN_SESSION_SECRET=

# --- Продавец --------------------------------------------------------------
# Номер WhatsApp получателя заказов, только цифры, без плюса (решение 13).
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Адрес точки выдачи для летерхеда бланка (решение 3).
NEXT_PUBLIC_SELLER_ADDRESS=
# Телефон продавца для летерхеда.
NEXT_PUBLIC_SELLER_PHONE=
